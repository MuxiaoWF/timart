<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络行为仅两类：Open-Meteo 天气调用 + GPS 条件地址解析兜底（Nominatim/Photon，仅发送输入的地点文字） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityManager 网络类型判定（设备条件）所需（普通权限，安装期授予） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi SSID 条件读取当前连接名（普通权限，安装期授予；运行时前置为定位权限+定位服务） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ 通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 仅 GPS 解锁条件使用（运行时申请），天气功能不请求定位 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 计步条件：仅 API 29+ 运行时申请（低版本直接读传感器） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 设置页「忽略电池优化」入口：跳系统电池优化列表页由用户手动设置（Play 政策合规：
         ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS 无需权限声明，故不声明
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS；仅影响后台判定/计步保活） -->

    <!-- NFC 挑战条件：读取标签 ID（reader mode，无写卡） -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".TimartApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Timart">

        <!-- 竖屏锁定为产品形态决策（信笺/时间胶囊叙事界面按竖屏构图）；
             Android 16 起系统在大屏设备将自动忽略该属性并按自适应运行，行为无碍 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity,Deprecated">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 备份 zip / 海报 PNG 分享用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
